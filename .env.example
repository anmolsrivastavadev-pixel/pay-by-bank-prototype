# Copy this file to .env.local and fill it in. Never commit .env.local.

# "demo" = pretend bank screens, no accounts needed.
# "truelayer" = TrueLayer sandbox (see docs/truelayer-setup.md).
PAYMENT_MODE=demo

# Shown to the shopper on the payment page.
SHOP_NAME="UKPI Demo Café"

# Optional. The address phones use to reach this server, e.g.
# http://192.168.0.47:3000. If empty, it's worked out from each request.
APP_BASE_URL=

# --- TrueLayer sandbox (only needed when PAYMENT_MODE=truelayer) ---
# Console > Settings: client id and secret (the secret is shown only once).
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
# Console > Payments > Settings > Signing keys: the KID shown after uploading
# your public key.
TRUELAYER_SIGNING_KEY_ID=
# The PRIVATE key file you made with openssl, pasted inside double quotes
# exactly as it is, line breaks included.
TRUELAYER_SIGNING_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----
paste the lines here
-----END EC PRIVATE KEY-----"
# Console > Payments > Merchant account: the GBP account's id.
TRUELAYER_MERCHANT_ACCOUNT_ID=
